rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboards/{gameType}/scores/{userId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && gameType in [
          'quick_math',
          'color_sequence',
          'emoji_match',
          'pattern_lock',
          'launch_rocket'
        ]
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 999999
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() >= 2
        && request.resource.data.playerName.size() <= 16
        && request.resource.data.playerId == userId
        && request.resource.data.gameType == gameType;
    }
  }
}
