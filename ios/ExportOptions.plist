<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- App Store export for `make build-ios`. Release builds are signed
     manually with the "LogicSprint App Store" profile (Apple Distribution
     certificate), which needs no registered devices. -->
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>4B2DVDN52W</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.trupal.logicsprint</key>
		<string>LogicSprint App Store</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
